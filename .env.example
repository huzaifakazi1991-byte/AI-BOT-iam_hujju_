# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Cloud SQL PostgreSQL Environment Variables (injected automatically by AI Studio)
SQL_HOST="localhost"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD"

# Multi-LLM Vendor Orchestration Keys (Server-Side KMS / Secret Manager Only)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

